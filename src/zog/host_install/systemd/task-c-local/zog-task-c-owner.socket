# Root-only local IPC until the runtime's OS peer-policy is reviewed.
[Unit]
Description=Zog Task C owner local IPC socket

[Socket]
ListenStream=/run/zog/task-c-owner.sock
SocketUser=root
SocketGroup=root
SocketMode=0600
DirectoryMode=0755
Accept=no
Service=zog-task-c-owner.service
RemoveOnStop=yes
# No [Install] section. Staging never listens.
