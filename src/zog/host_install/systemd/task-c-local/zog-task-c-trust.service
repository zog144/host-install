# Local Host trust/observation service; no external S3 history authority.
[Unit]
Description=Zog Task C local trust observer
Requires=zog-task-c-trust.socket
After=local-fs.target

[Service]
Type=exec
User=root
Group=root
Sockets=zog-task-c-trust.socket
ExecStart=/opt/zog/task-c/venv/bin/python -I -m zog.host_deploy.gateway.task_c_local_trust_daemon
NoNewPrivileges=yes
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=/etc/zog/task-c
ReadOnlyPaths=/var/lib/zog/task-c/owner
ReadWritePaths=/var/lib/zog/task-c/trust
StandardOutput=journal
StandardError=journal
# No signed history records, S3 credentials or separate AWS role.
# No [Install] section. Staging never runs this service.
