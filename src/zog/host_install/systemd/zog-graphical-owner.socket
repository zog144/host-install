[Unit]
Description=Protected Zog graphical operation owner private IPC socket
Documentation=man:systemd.socket(5)

[Socket]
ListenStream=/run/zog/graphical-operation-owner.sock
SocketUser=root
SocketGroup=zog-graphical-client
SocketMode=0660
Service=zog-graphical-owner.service
Accept=no
RemoveOnStop=yes

# Deliberately no Install section. Native operator authorization required.
