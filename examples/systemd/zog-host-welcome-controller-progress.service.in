[Unit]
Description=Read-only controller progress broker for host-welcome
After=sysinit.target

[Service]
Type=simple
Sockets=zog-host-welcome-controller-progress.socket
User=@CONTROLLER_UID@
Group=@CONTROLLER_GID@
ExecStart=@PYTHON_EXECUTABLE@ -m zog.box_control.application_progress_broker --project @CONTROLLER_PROJECT@ --authorized-uid @WELCOME_UID@ --root-control-socket /run/zog/root-control.sock --observer-role host-welcome --controller-owner-uid @CONTROLLER_UID@
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
UMask=0077
Restart=on-failure
RestartSec=2s
StandardOutput=journal
StandardError=journal
