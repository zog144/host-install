[Unit]
Description=Read-only image-build progress broker for host-welcome
After=sysinit.target

[Service]
Type=simple
Sockets=zog-host-welcome-image-progress.socket
User=@IMAGE_BUILD_UID@
Group=@IMAGE_BUILD_GID@
ExecStart=@PYTHON_EXECUTABLE@ -m zog.image_build.post_install_progress_broker --state-dir @IMAGE_BUILD_STATE_ROOT@ --authorized-uid @WELCOME_UID@ --application agreety --application chromium --application firefox --application firefox-esr --application greetd --application i3 --application turbovnc --application weston --application xorg-server --source-repository zog144/image-build --source-revision fcc12f3db959afe395b1adfb5b0b4dc1f16a3258
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=@IMAGE_BUILD_STATE_ROOT@
UnsetEnvironment=PYTHONPATH PYTHONHOME
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
Restart=on-failure
RestartSec=2s
StandardOutput=journal
StandardError=journal
