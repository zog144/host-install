[Unit]
Description=Read-only image-build post-install progress broker for host-welcome
After=sysinit.target

[Service]
Type=simple
Sockets=zog-host-welcome-image-progress.socket
User=@IMAGE_BUILD_UID@
Group=@IMAGE_BUILD_GID@
Environment=PYTHONPATH=
ExecStart=@PYTHON_EXECUTABLE@ -m zog.image_build.post_install_progress_broker --state-dir @IMAGE_BUILD_STATE@ --authorized-uid @WELCOME_UID@ --application agreety --application firefox-esr --application greetd --application i3 --application xorg-server --source-repository zog144/image-build --source-revision 7348ec730a3181f1a8ecc62a6e4d633ce191674a
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
ReadOnlyPaths=@IMAGE_BUILD_STATE@
UMask=0077
Restart=on-failure
RestartSec=2s
StandardOutput=journal
StandardError=journal
